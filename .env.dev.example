# ==============================================================================
# ASAAS API — AMBIENTE DE DESENVOLVIMENTO LOCAL (.env.dev.example)
# Copie para .env (cp .env.dev.example .env) para rodar a aplicação localmente:
#   1. Subir infraestrutura local: docker compose -f docker-compose.dev.yml up -d
#   2. Rodar migrations: npx prisma migrate dev
#   3. Iniciar API: npm run dev
# ==============================================================================

# ------------------------------------------------------------------------------
# Servidor HTTP & Ambiente
# ------------------------------------------------------------------------------
PORT=5006
NODE_ENV=development

# ------------------------------------------------------------------------------
# Autenticação Interna & RBAC Granular (M2M)
# ------------------------------------------------------------------------------
# Chave Master/Admin (acesso completo a todas as rotas e métodos)
API_KEY=local_api_key_secret_123

# Chave restrita a consultas GET (opcional para testes de escopo RBAC)
# API_KEY_READ=local_read_only_key_secret_456

# Chave restrita a transações de cobrança e consultas (opcional)
# API_KEY_PAYMENTS=local_payments_key_secret_789

# ------------------------------------------------------------------------------
# Criptografia de Cartão em Trânsito (PCI-DSS Envelope AES-256-GCM)
# ------------------------------------------------------------------------------
# Chave de 32 bytes (256 bits) para envelope criptográfico no RabbitMQ
CARD_ENCRYPTION_KEY=dev_aes256_secret_key_32bytes_ok!

# ------------------------------------------------------------------------------
# Documentação Swagger UI / OpenAPI Spec
# ------------------------------------------------------------------------------
# Em modo development, o Swagger está habilitado por padrão em http://localhost:5006/docs
# sem necessidade de credenciais.
SWAGGER_ENABLED=true
# SWAGGER_USER=admin
# SWAGGER_PASSWORD=admin

# ------------------------------------------------------------------------------
# Integração Asaas v3 Gateway (Sandbox)
# ------------------------------------------------------------------------------
# Obtenha sua chave no painel Sandbox do Asaas: https://sandbox.asaas.com
ASAAS_API_KEY="$aact_sua_chave_sandbox_asaas_aqui"
ASAAS_ENVIRONMENT=sandbox
ASAAS_WEBHOOK_SECRET=token_webhook_sandbox_123

# ------------------------------------------------------------------------------
# Banco de Dados PostgreSQL (Conexão com container docker-compose.dev.yml)
# ------------------------------------------------------------------------------
# O container de dev expõe a porta 5432 internamente mapeada para 5436 no host
DATABASE_URL="postgresql://postgres:postgres@localhost:5436/asaas_db?schema=public"

# ------------------------------------------------------------------------------
# RabbitMQ Mensageria (Conexão com container docker-compose.dev.yml)
# ------------------------------------------------------------------------------
# AMQP mapeado na porta 5676 do host; Painel Management em http://localhost:15672 (guest/guest)
RABBITMQ_URL="amqp://guest:guest@localhost:5676"
RABBITMQ_MAIN_QUEUE="asaas_main_queue"
RABBITMQ_DLQ_QUEUE="asaas_dlq_queue"

# ------------------------------------------------------------------------------
# Webhook Forwarder (Repasse de eventos para o Backend Consumidor)
# ------------------------------------------------------------------------------
# URL do endpoint no seu backend principal para receber os eventos tratados
CLIENT_WEBHOOK_URL="http://localhost:3001/api/webhooks/asaas"
CLIENT_WEBHOOK_SECRET="segredo_para_assinar_o_repasse_dev"
