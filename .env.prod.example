# ==============================================================================
# ASAAS API — AMBIENTE DE PRODUÇÃO (.env.prod.example)
# Copie para .env ou configure no seu gerenciador de segredos / CI/CD:
#   Para stack Docker: docker compose -f docker-compose.prod.yml up -d --build
# ==============================================================================

# ------------------------------------------------------------------------------
# Servidor HTTP & Ambiente
# ------------------------------------------------------------------------------
PORT=5006
NODE_ENV=production

# ------------------------------------------------------------------------------
# Autenticação Interna & RBAC Granular (Hardening de Segurança M2M)
# ------------------------------------------------------------------------------
# ATENÇÃO: Em produção, a API_KEY DEVE ter no mínimo 32 caracteres e NÃO PODE usar
# valores padrão (ex: 'local_api_key_secret_123', 'changeme'). A aplicação aborta
# a inicialização se um segredo fraco for detectado.
API_KEY=coloque_aqui_sua_chave_mestre_forte_com_no_minimo_32_caracteres!

# Chaves de escopo restrito (Princípio do Menor Privilégio - Recomendado):
# API_KEY_READ=chave_somente_leitura_minimo_32_caracteres_producao!
# API_KEY_PAYMENTS=chave_apenas_pagamentos_minimo_32_caracteres_producao!

# ------------------------------------------------------------------------------
# Criptografia de Envelope em Trânsito (PCI-DSS Requisitos 3 e 4)
# ------------------------------------------------------------------------------
# Chave secreta de 256 bits (32 bytes) para cifragem AES-256-GCM dos dados de cartão
# no RabbitMQ. Nunca compartilhe ou perca esta chave.
CARD_ENCRYPTION_KEY=defina_uma_chave_secreta_aes256_de_32_bytes_aqui!

# ------------------------------------------------------------------------------
# Hardening do Swagger UI / OpenAPI em Produção
# ------------------------------------------------------------------------------
# Por padrão em produção, /docs e /docs-json são DESABILITADOS (HTTP 404).
# Se precisar liberar acesso para a equipe técnica, defina SWAGGER_ENABLED=true e
# configure usuário e senha para proteção via HTTP Basic Auth.
SWAGGER_ENABLED=false
# SWAGGER_USER=admin_docs_producao
# SWAGGER_PASSWORD=senha_altamente_segura_para_docs_producao_2026

# ------------------------------------------------------------------------------
# Integração Asaas v3 Gateway (Ambiente de Produção Real)
# ------------------------------------------------------------------------------
# Chave de API oficial gerada no painel de produção: https://www.asaas.com
ASAAS_API_KEY="$aact_sua_chave_oficial_de_producao_asaas_aqui"
ASAAS_ENVIRONMENT=production
# Token de webhook configurado na gestão de integrações do Asaas em produção:
ASAAS_WEBHOOK_SECRET=token_secreto_configurado_no_painel_asaas_prod

# ------------------------------------------------------------------------------
# Credenciais para provisionamento via docker-compose.prod.yml
# ------------------------------------------------------------------------------
# Utilizadas pelo docker-compose.prod.yml para configurar os containers de banco e fila.
# Ambas as variáveis abaixo são de preenchimento obrigatório pelo docker-compose.
POSTGRES_USER=app_asaas_user
POSTGRES_PASSWORD=defina_uma_senha_muito_forte_para_o_postgres_prod
POSTGRES_DB=asaas_prod_db

RABBITMQ_DEFAULT_USER=app_asaas_rmq_admin
RABBITMQ_DEFAULT_PASS=defina_uma_senha_muito_forte_para_o_rabbitmq_prod

# ------------------------------------------------------------------------------
# URLs de Conexão com Serviços de Infraestrutura
# ------------------------------------------------------------------------------
# Caso utilize docker-compose.prod.yml, estas URLs são injetadas automaticamente
# através das variáveis acima pela rede interna 'asaas_network'.
# Se rodar a API fora do Docker Compose (ex: Kubernetes, ECS, Bare-metal), informe:
# DATABASE_URL="postgresql://app_asaas_user:sua_senha@seu_postgres_host:5432/asaas_prod_db?schema=public&sslmode=prefer"
# RABBITMQ_URL="amqp://app_asaas_rmq_admin:sua_senha@seu_rabbitmq_host:5672"

RABBITMQ_MAIN_QUEUE="asaas_main_queue"
RABBITMQ_DLQ_QUEUE="asaas_dlq_queue"

# ------------------------------------------------------------------------------
# Webhook Forwarder (Repasse assinado ao Backend Consumidor)
# ------------------------------------------------------------------------------
# Endpoint seguro (HTTPS obrigatório em produção) no seu backend principal
CLIENT_WEBHOOK_URL="https://api.suaempresa.com.br/api/webhooks/asaas"
CLIENT_WEBHOOK_SECRET="segredo_de_alta_entropia_para_assinar_o_repasse_ao_consumidor"
